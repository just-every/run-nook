{
  "schema": 1,
  "project": {
    "schema": 1,
    "projectId": "just-every/nook",
    "name": "Nook",
    "sourceRepository": "https://github.com/just-every/run-nook",
    "license": "MIT",
    "deployment": {
      "target": "cloudflare-workers",
      "artifactFile": "nook-worker-artifact.json"
    },
    "operations": {
      "setup": "pnpm install --frozen-lockfile && pnpm exec rer install --non-interactive",
      "build": "pnpm exec rer build --non-interactive",
      "verify": "pnpm exec rer verify --non-interactive",
      "artifact": "node scripts/build-delivery-artifact.mjs",
      "recovery": "Keep the repository and installation private. Stop Nook; retain source, private settings and all additive migrations. Use rer export to a private archive, rer import into empty inactive local state, and the documented offline identity mapping before normal sign-in. Compare re-exported records and media. Local proof is not hosted deployment acceptance; see OPERATIONS.md."
    },
    "verification": {
      "sensitivePaths": [
        "src/base/**",
        "src/platform/**",
        "src/server.ts",
        "scripts/**",
        "migrations/**",
        "rer-setup.json",
        "owner-deployment.json",
        "src/team/**",
        "src/editor/**",
        "src/routes/**",
        "src/router.tsx"
      ],
      "migrationDirectories": [
        "migrations"
      ],
      "guidanceFiles": [
        "AGENTS.md",
        "OPERATIONS.md",
        "CONTRACT.md"
      ],
      "testPatterns": [
        "tests/**"
      ]
    }
  },
  "managed": {
    "workflowRef": "runeditrun/delivery/.github/workflows/trusted-build.yml@bf7a25abb44bec1457a7bc738ff63921d90fb52e",
    "artifactFile": "nook-worker-artifact.json",
    "buildProfile": "project",
    "pnpmVersion": "10.12.4",
    "verificationProfiles": [
      "full"
    ]
  },
  "artifact": {
    "specInputs": {
      "providerEffects": [],
      "publicVariableNames": [
        "AUTH_ORIGIN",
        "AUTH_LOCAL",
        "OWNER_EMAIL",
        "MAIL_PROVIDER",
        "MAIL_FROM",
        "RER_MANAGEMENT_ORIGIN",
        "RER_INSTALLATION_ID",
        "RER_OWNER_CLAIM_ISSUER",
        "RER_OWNER_CLAIM_INSTALLATION_ID",
        "RER_OWNER_CLAIM_APP_ORIGIN",
        "RER_OWNER_CLAIM_PUBLIC_KEYS"
      ],
      "secretNames": [
        "SESSION_SECRET",
        "SETUP_TOKEN"
      ],
      "optionalSecretNames": [],
      "healthPath": "/health",
      "recovery": "Keep the repository and installation private. Stop Nook; retain source, private settings and all additive migrations. Use rer export to a private archive, rer import into empty inactive local state, and the documented offline identity mapping before normal sign-in. Compare re-exported records and media. Local proof is not hosted deployment acceptance; see OPERATIONS.md.",
      "surfaces": {
        "app": {
          "path": "/signin"
        },
        "page": {
          "path": "/"
        }
      }
    }
  },
  "edition": {
    "manifestFile": "edition.json",
    "componentId": "just-every/nook"
  },
  "setup": {
    "manifestFile": "rer-setup.json"
  }
}
