{
  "schema": 1,
  "title": "Nook",
  "groups": [
    {
      "id": "workspace",
      "label": "Workspace"
    },
    {
      "id": "owner",
      "label": "First owner"
    },
    {
      "id": "mail",
      "label": "Local sign-in",
      "help": "Hosting requires a mail provider and a verified sender. Local development sends and stores no email."
    }
  ],
  "fields": [
    {
      "name": "WORKSPACE_NAME",
      "label": "Workspace name",
      "kind": "text",
      "required": true,
      "default": "Nook",
      "group": "workspace"
    },
    {
      "name": "PRIMARY_COLOR",
      "label": "Brand colour",
      "kind": "colour",
      "required": true,
      "default": "#c24e5b",
      "group": "workspace"
    },
    {
      "name": "OWNER_EMAIL",
      "label": "Owner email",
      "kind": "email",
      "required": true,
      "group": "owner",
      "help": "The first owner uses this address to sign in.",
      "prefill": "account-email"
    },
    {
      "name": "SESSION_SECRET",
      "label": "Session secret",
      "kind": "secret",
      "required": true,
      "ownerVisible": false,
      "input": "managed",
      "generate": "hex",
      "group": "owner"
    },
    {
      "name": "SETUP_TOKEN",
      "label": "Setup token",
      "kind": "secret",
      "required": true,
      "ownerVisible": false,
      "generate": "hex",
      "group": "owner",
      "input": "managed"
    },
    {
      "name": "MAIL_PROVIDER",
      "label": "Mail delivery",
      "kind": "select",
      "required": true,
      "default": "development",
      "options": [
        {
          "value": "development",
          "label": "Local development (no email sent)"
        }
      ],
      "group": "mail"
    },
    {
      "name": "MAIL_FROM",
      "label": "Local sender",
      "kind": "email",
      "required": true,
      "group": "mail",
      "help": "Placeholder sender only. Local sign-in uses the private RER_OPEN development session; no email is sent or stored.",
      "default": "auth@localhost.test"
    },
    {
      "name": "IDENTITY_PROVIDER",
      "label": "Identity provider",
      "kind": "url",
      "required": false,
      "default": "",
      "help": "Optional Auth install. Leave empty to use email links."
    }
  ],
  "steps": [
    {
      "type": "owner-claim",
      "mode": "signed",
      "emailField": "OWNER_EMAIL",
      "tokenField": "SETUP_TOKEN",
      "path": "/auth/owner-claim"
    }
  ],
  "dependencies": [
    {
      "interface": "oidc-provider@1",
      "optional": true,
      "cardinality": 1,
      "address": "IDENTITY_PROVIDER",
      "paths": [
        "/auth/oidc/auth/callback",
        "/auth/oidc/auth/logout"
      ]
    }
  ],
  "business": {
    "settings": 1,
    "values": [
      "display_name"
    ],
    "team": {
      "roles": {
        "admin": "admin",
        "member": "member"
      }
    }
  }
}
