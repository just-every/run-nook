{
  "version": 1,
  "project": "just-every/nook",
  "compatibilityDate": "2026-09-08",
  "compatibilityFlags": [
    "nodejs_compat"
  ],
  "d1": [
    {
      "binding": "DB"
    }
  ],
  "r2": [
    {
      "binding": "FILES"
    }
  ],
  "queues": [],
  "durableObjects": [
    {
      "binding": "CHAT_HUB",
      "className": "ChatHub",
      "storage": "sqlite"
    }
  ],
  "crons": [],
  "secrets": [
    {
      "binding": "SESSION_SECRET",
      "environment": "SESSION_SECRET"
    },
    {
      "binding": "SETUP_TOKEN",
      "environment": "SETUP_TOKEN"
    },
    {
      "binding": "OWNER_EMAIL",
      "environment": "OWNER_EMAIL"
    },
    {
      "binding": "MAIL_FROM",
      "environment": "MAIL_FROM",
      "optional": true,
      "verifyStandIn": "auth@example.test"
    },
    {
      "binding": "SENDGRID_API_KEY",
      "environment": "SENDGRID_API_KEY",
      "optional": true,
      "verifyStandIn": "test-only-sendgrid-key"
    },
    {
      "binding": "MAIL_API_KEY",
      "environment": "SENDGRID_API_KEY",
      "optional": true
    },
    {
      "binding": "MAIL_PROVIDER",
      "environment": "MAIL_PROVIDER",
      "optional": true
    }
  ],
  "originVar": "AUTH_ORIGIN",
  "vars": {
    "AUTH_LOCAL": "false",
    "MAIL_PROVIDER": "sendgrid"
  },
  "platforms": [
    "workers",
    "container"
  ],
  "publicSettings": [
    "MAIL_PROVIDER"
  ]
}
