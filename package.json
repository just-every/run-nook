{
  "name": "@team-chat/team-workspace",
  "version": "0.4.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/just-every/run-nook.git"
  },
  "type": "module",
  "engines": {
    "node": "22.20.0"
  },
  "scripts": {
    "setup": "rer setup",
    "dev": "rer dev",
    "preview": "rer preview",
    "build": "rer build",
    "verify": "rer verify",
    "reset": "rer reset",
    "deploy": "rer deploy",
    "export": "rer export",
    "import": "rer import",
    "release": "rer release",
    "doctor": "rer doctor",
    "describe": "rer describe",
    "check": "rer check",
    "deps": "rer install",
    "rer": "rer",
    "onboard": "node scripts/install.mjs",
    "build:app": "vite build",
    "verify:app": "pnpm verify:core && pnpm test:pilot",
    "verify:core": "pnpm test:base && pnpm test && pnpm run build:app && pnpm integration:check && pnpm typecheck && rer build --site && pnpm test:runtime && pnpm test:readme && pnpm test:notify && pnpm test:push",
    "typecheck": "tsc --noEmit",
    "test": "node --test --test-concurrency=2 tests/*.test.mjs",
    "test:runtime": "node tests/runtime.mjs",
    "test:homepage": "node tests/homepage.mjs",
    "test:readme": "node tests/readme-journey.mjs",
    "test:pilot": "node tests/pilot-journey.mjs",
    "test:base": "node scripts/edition-authoring/cli.mjs check && node scripts/edition-authoring/cli.mjs verify-base --offline && rer check --profile first-party",
    "test:notify": "node tests/notify-journey.mjs",
    "test:push": "node --test --test-concurrency=1 tests/push-journey.mjs",
    "integration:generate": "node scripts/delivery/integration.mjs",
    "integration:check": "node scripts/delivery/integration.mjs --check"
  },
  "dependencies": {
    "@tanstack/react-router": "1.170.33",
    "@tanstack/react-start": "1.168.50",
    "hono": "4.13.7",
    "parse5": "8.0.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sql.js": "1.15.0",
    "unpdf": "1.9.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.5",
    "@cloudflare/workers-types": "5.20260908.1",
    "@playwright/test": "1.64.1",
    "@runeditrun/rer": "0.2.63",
    "@types/node": "26.0.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "axe-core": "4.14.0",
    "highlight.js": "10.7.3",
    "react-markdown": "6.0.3",
    "remark-gfm": "1.0.0",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "wrangler": "4.142.0"
  },
  "packageManager": "pnpm@10.12.4",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd",
      "@parcel/watcher"
    ],
    "overrides": {
      "sharp@<0.35.5": "0.35.5",
      "source-map-js@<1.2.2": "1.2.2",
      "undici@>=7.0.0 <7.29.1": "7.29.1"
    }
  }
}
